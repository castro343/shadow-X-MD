{
  "name": "SHADOW X MD",
  "description": "SHADOW X MD WhatsApp automation bot",
  "logo": "https://raw.githubusercontent.com/castro343/shadow-X-MD/main/thumbnail/image.jpg",
  "keywords": [
    "whatsapp",
    "bot",
    "shadow-x-md",
    "baileys",
    "pairing"
  ],
  "repository": "https://github.com/castro343/shadow-X-MD.git",
  "scripts": {
    "start": "node index.js"
  },
  "env": {
    "OWNER_NUMBER": {
      "description": "Primary bot owner number in international format, digits only.",
      "value": "",
      "required": true
    },
    "BOT_MODE": {
      "description": "Bot operating mode (public or private).",
      "value": "public",
      "required": false
    },
    "NEWSLETTER_ID": {
      "description": "Optional WhatsApp Channel ID for forwarded newsletter context.",
      "value": "",
      "required": false
    },
    "NGROK_AUTHTOKEN": {
      "description": "Optional. Only needed if you want an additional Ngrok tunnel.",
      "value": "",
      "required": false
    }
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    }
  },
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    },
    {
      "url": "https://github.com/jonathanong/heroku-buildpack-ffmpeg-latest.git"
    },
    {
      "url": "https://github.com/clhuang/heroku-buildpack-webp-binaries.git"
    }
  ]
}
